---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import InquiryModal from '../../components/InquiryModal.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { ACQUISITION_EMAIL } from '../../lib/constants';

const title = 'Privacy Policy | icra.builders';
const description =
  'Privacy policy for icra.builders — what information the inquiry form collects, how it is used, and how to contact us about your data.';
const breadcrumbs = [{ name: 'Privacy', url: '/privacy/' }];
const pageName = 'Privacy Policy';
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} pageName={pageName} noindex>
  <Nav />
  <Breadcrumbs items={breadcrumbs} />

  <main class="max-w-screen-2xl mx-auto px-6 md:px-8 py-10 md:py-14">
    <article class="max-w-3xl">
      <header class="mb-8">
        <h1 class="text-4xl sm:text-5xl tracking-tighter font-bold leading-[1.08] mb-4">Privacy policy</h1>
        <p class="text-slate-600">Last updated: September 2026</p>
      </header>

      <div class="space-y-6 text-slate-700 leading-relaxed text-[16px]">
        <section>
          <h2 class="text-xl font-semibold text-slate-900 mb-2">What we collect</h2>
          <p>
            If you submit the confidential inquiry form, we collect the information you enter: name, company
            (optional), email address, phone number (optional), and your message. The form also includes a hidden
            honeypot field used solely to detect spam submissions.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-900 mb-2">How we use it</h2>
          <p>
            Inquiry details are emailed to our acquisition team so we can respond to your interest in the
            icra.builders domain. We do not sell your information. We use it only to reply to your inquiry and to
            maintain a basic record of correspondence.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-900 mb-2">Technical data</h2>
          <p>
            Our hosting provider (Cloudflare) may process standard request metadata — such as IP address, user agent,
            and referrer — for delivery, security, and abuse prevention. If Cloudflare Web Analytics is enabled, its
            cookieless beacon measures aggregate traffic and page performance. We do not use that data to build
            advertising profiles.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-900 mb-2">Retention &amp; your choices</h2>
          <p>
            We retain inquiry emails only as long as needed to conduct the conversation and for legitimate business
            records. You may request access to, correction of, or deletion of information you have submitted by
            emailing us.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-900 mb-2">Contact</h2>
          <p>
            Questions about this policy or your data:
            <a href={`mailto:${ACQUISITION_EMAIL}`} class="text-teal-700 font-medium underline decoration-teal-300 underline-offset-4">{ACQUISITION_EMAIL}</a>.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-slate-900 mb-2">Changes</h2>
          <p>
            We may update this policy periodically. The “Last updated” date above reflects the current version.
          </p>
        </section>
      </div>
    </article>
  </main>

  <Footer />
  <InquiryModal />
</BaseLayout>

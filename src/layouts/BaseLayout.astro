---
import '../styles/global.css';
import StructuredData from '../components/StructuredData.astro';
import type { BreadcrumbItem, FaqItem } from '../components/StructuredData.astro';
import {
  SITE_NAME,
  SITE_URL,
  HERO_IMAGE_URL,
  GOOGLE_SITE_VERIFICATION,
  CF_WEB_ANALYTICS_TOKEN,
} from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  faq?: FaqItem[];
  pageName?: string;
}

const {
  title = `${SITE_NAME} | Premium Domain for Sale | ICRA Healthcare Construction`,
  description = 'Acquire icra.builders — the definitive, brandable domain for specialized healthcare construction, ICRA-compliant renovations, and infection control expertise in occupied medical facilities.',
  noindex = false,
  breadcrumbs = [],
  faq = [],
  pageName,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, SITE_URL).href;
const ogImage = HERO_IMAGE_URL;
const themeColor = '#0D9488';
const beaconConfig = JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN });
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <meta name="keywords" content="ICRA builders, infection control risk assessment, healthcare construction, ICRA compliance, hospital renovation, ICRA training, premium domain, .builders domain" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE_NAME} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content="icra.builders — premium domain for ICRA-focused healthcare construction" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="icra.builders" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <StructuredData breadcrumbs={breadcrumbs} faq={faq} pageName={pageName} />

    {
      CF_WEB_ANALYTICS_TOKEN && (
        <script
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={beaconConfig}
          defer
        />
      )
    }
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <slot />
  </body>
</html>
